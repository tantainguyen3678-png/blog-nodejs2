<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Danh sách bài viết của tôi</h3>
        <a href="/blogs/create" class="btn btn-primary btn-sm">+ Đăng bài viết mới</a>
    </div>

    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th scope="col" class="text-center">STT</th>
                <th scope="col">Tên bài viết</th>
                <th scope="col">Ngày tạo</th>
                <th scope="col" class="text-center">Hành động</th>
            </tr>
        </thead>
        <tbody>
            {{#each blogs}}
            <tr>
                <!-- Helper @index + 1 để đánh số thứ tự 1, 2, 3... -->
                <th scope="row" class="text-center">{{#eq @index undefined}}{{else}}{{/eq}}{{sum @index 1}}</th>
                <td><strong>{{this.name}}</strong></td>
                <td>{{this.createdAt}}</td>
                <td class="text-center">
                    <!-- Nút Sửa -->
                    <a href="/blogs/{{this._id}}/edit" class="btn btn-warning btn-sm me-2">Sửa</a>
                    
                    <!-- Form Nút Xóa (Dùng method-override) -->
                    <form method="POST" action="/blogs/{{this._id}}?_method=DELETE" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa bài viết này?')">
                        <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                    </form>
                </td>
            </tr>
            {{else}}
            <tr>
                <td colspan="4" class="text-center py-4 text-muted">
                    Bạn chưa đăng bài viết nào. <a href="/blogs/create">Đăng bài ngay!</a>
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</div>