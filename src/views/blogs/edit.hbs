<div class="container mt-4">
    <div class="newsletter">
        <h3 class="mb-4">Cập nhật bài viết</h3>
        
        {{#if blog}}
        <form method="POST" action="/blogs/{{blog._id}}?_method=PUT">
            <div class="form-group mb-3">
                <label for="name" class="form-label fw-bold">Tiêu đề bài viết</label>
                <input type="text" class="form-control" id="name" value="{{blog.name}}" name="name" required>
            </div>

            <div class="form-group mb-3">
                <label for="content" class="form-label fw-bold">Nội dung bài viết</label>
                <textarea class="form-control" id="content" name="content" rows="5" required>{{blog.content}}</textarea>
            </div>

            <div class="form-group mb-3">
                <label for="tag" class="form-label fw-bold">Thẻ (Tag)</label>
                <input type="text" class="form-control" id="tag" value="{{blog.tag}}" name="tag">
            </div>

            <div class="form-group mb-3">
                <label for="img" class="form-label fw-bold">Link hình ảnh bài viết</label>
                <input type="text" class="form-control" id="img" value="{{blog.img}}" name="img">
            </div>

            <div class="form-group mb-3">
                <label for="author_img" class="form-label fw-bold">Link hình ảnh tác giả</label>
                <input type="text" class="form-control" id="author_img" value="{{blog.author_img}}" name="author_img">
            </div>

            <div class="form-group mb-4">
                <label for="author_name" class="form-label fw-bold">Tên tác giả</label>
                <input type="text" class="form-control" id="author_name" value="{{blog.author_name}}" name="author_name">
            </div>

            <div class="d-flex justify-content-end">
                <button type="submit" class="btn btn-primary px-4">Lưu lại</button>
            </div>
        </form>
        {{else}}
        <div class="alert alert-warning">Không tìm thấy thông tin bài viết để cập nhật!</div>
        {{/if}}
    </div>
</div>